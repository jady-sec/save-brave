// Deployed as a Worker: `npm run build && npx wrangler deploy`
{
  "name": "save-brave",
  "compatibility_date": "2025-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serves index.html for app routes like /plan (replaces Pages' _redirects)
    "not_found_handling": "single-page-application"
  },
  // Daily keep-alive so the free Supabase project never pauses (worker/index.js)
  "triggers": { "crons": ["17 9 * * *"] }
}
